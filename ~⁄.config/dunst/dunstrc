[global]
    follow = mouse
    width = (300, 650)
    height = (0, 200)
    origin = top-right
    offset = (16, 48)
    notification_limit = 5

    padding = 12
    horizontal_padding = 16
    frame_width = 2
    corner_radius = 0
    separator_height = 6
    separator_color = "#00000000"

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 0

    font = Source Code Pro 11
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = -1
    icon_position = left
    max_icon_size = 32
    sticky_history = no
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1c1c1ee6"
    foreground = "#cfc8b8"
    frame_color = "#595959"
    highlight = "#595959"
    timeout = 4

[urgency_normal]
    background = "#1c1c1ee6"
    foreground = "#f5ecd7"
    frame_color = "#f5ecd7"
    highlight = "#f5ecd7"
    timeout = 6

[urgency_critical]
    background = "#1c1c1ee6"
    foreground = "#ffffff"
    frame_color = "#e0a030"
    highlight = "#e0a030"
    timeout = 0
